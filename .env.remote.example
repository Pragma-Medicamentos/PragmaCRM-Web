# Copiá a .env.remote.local (cubierto por *.local en .gitignore):
#   cp .env.remote.example .env.remote.local
#
# Uso con: npm run dev:remote
# Solo Vite local → API YA desplegada. No arranca Api.
#
# Variable que manda la base de la API: VITE_API_URL (sin barra final)
# Completá también VITE_API_KEY + Supabase del mismo entorno remoto
# (auth tiene que ser el proyecto que usa esa Api).

VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_API_URL=https://api.<dominio>
VITE_API_KEY=

VITE_UPLOAD_MAX_FILE_SIZE_MB=100
