# Supabase Auth (mismo proyecto que usa PragmaCRM-Api)
# Local: valores de `npx supabase status` en PragmaCRM-Api. Nunca la
# service_role key aqui - esa es solo de servidor.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# URL base de PragmaCRM-Api (sin barra final)
VITE_API_URL=http://localhost:3000

# Tope de peso del archivo que acepta POST /api/v1/uploads/sales, en MB.
# Opcional: si se omite se asume 100. Debe coincidir con
# UPLOAD_MAX_FILE_SIZE_MB del .env de PragmaCRM-Api, que es quien manda de
# verdad — este valor solo evita un viaje de red para un archivo que la API
# rechazaria igual.
# Ojo en despliegue: nginx limita el cuerpo a 1 MiB por defecto y respondería
# 413 antes de llegar a la API, sin importar lo que diga este numero.
VITE_UPLOAD_MAX_FILE_SIZE_MB=100

# Secreto compartido enviado en el header `x-api-key` (gate de transporte,
# no de identidad). Debe coincidir con API_KEY en el .env de PragmaCRM-Api.
# No es sensible de la misma forma que la service_role key: viaja igual en
# el bundle web y en la APK, no otorga identidad ni permisos por si solo.
VITE_API_KEY=
